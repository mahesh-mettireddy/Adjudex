# Copy this file to `.env` and fill in values. `.env` is git-ignored.
# These variables are read ONLY by the Node API in /server. Never prefix them
# with VITE_ (Vite would bundle them into the public website).

# --- Gemini (optional; used only for demo case generation) -----------------
# Without a key, /api/demo/generate-case transparently uses the deterministic
# local generator and says so in the response.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000

# --- API server -----------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Comma-separated list of browser origins allowed to call the API (CORS).
# Leave empty to allow same-origin / server-to-server callers only.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated API keys that callers must send as `Authorization: Bearer <key>`
# or `X-API-Key: <key>` for /api/v1/*. Leave empty to run /api/v1/* open (local dev only).
ADJUDEX_API_KEYS=
# Set to 1 only when running behind a trusted reverse proxy (uses X-Forwarded-For).
TRUST_PROXY=0

# --- Limits -------------------------------------------------------------------------
RATE_LIMIT_PER_MIN=120
DEMO_RATE_LIMIT_PER_MIN=10
MAX_BODY_BYTES=65536
MAX_STORE_ENTRIES=5000
